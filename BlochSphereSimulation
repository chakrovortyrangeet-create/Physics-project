import numpy as np
import matplotlib.pyplot as plt
from matplotlib.widgets import Slider

def draw_bloch_sphere(ax, theta, phi):
    ax.clear()

    u = np.linspace(0, 2 * np.pi, 100) #generates a continuous set of evenly distributed domain values over a specific range to accurately render curves and plots
    v = np.linspace(0, np.pi, 100)

    x = np.outer(np.cos(u), np.sin(v)) #to produce a 2D matrix from two 1D arrays by multiplying every element of the first vector with every element of the second vector
    y = np.outer(np.sin(u), np.sin(v))
    z = np.outer(np.ones_like(u), np.cos(v)) #np.ones_like(u) generates an matrix filled with 1s of size equal to matrix u

    ax.plot_surface(x, y, z, alpha=0.15)#generates a surface for plotting the bloch sphere. alpha denotes the opacity of the surface

    ax.plot([-1, 1], [0, 0], [0, 0], color="black")
    ax.plot([0, 0], [-1, 1], [0, 0], color="black")
    ax.plot([0, 0], [0, 0], [-1, 1], color="black")

    ax.text(0, 0, 1.15, "|0⟩", ha="center")
    ax.text(0, 0, -1.15, "|1⟩", ha="center")

    x_state = np.sin(theta) * np.cos(phi)
    y_state = np.sin(theta) * np.sin(phi)
    z_state = np.cos(theta)

    ax.quiver(
        0, 0, 0,
        x_state, y_state, z_state,
        color="red",
        linewidth=2,
        arrow_length_ratio=0.12
    )

    ax.scatter(x_state, y_state, z_state, color="red", s=50)

    ax.set_xlabel("X")
    ax.set_ylabel("Y")
    ax.set_zlabel("Z")

    ax.set_xlim(-1.2, 1.2)
    ax.set_ylim(-1.2, 1.2)
    ax.set_zlim(-1.2, 1.2)

    ax.set_box_aspect([1, 1, 1])
    ax.set_title("Interactive Bloch Sphere")


